  stack_address : UInt64?
  kind : String
  module_index : Int32?
  module_name : String
  offset : UInt64?
  in_function_table : Bool?
  return_site : String
}
pub fn StackFrame::equal(Self, Self) -> Bool
pub fn StackFrame::not_equal(Self, Self) -> Bool
pub fn StackFrame::to_repr(Self) -> @debug.Repr

#derive(Eq, @debug.Debug)
pub(all) struct StackWalk {
  thread_id : UInt32
  layout : String
  pointer_size : UInt32
  supported : Bool
  reason : String
  frames : Array[StackFrame]
  notes : Array[String]
  fp_frames : Int32
  scanned_slots : Int64
  scan_limited : Bool
  window_low : UInt64?
  window_high : UInt64?
}
pub fn StackWalk::equal(Self, Self) -> Bool
pub fn StackWalk::not_equal(Self, Self) -> Bool
pub fn StackWalk::to_repr(Self) -> @debug.Repr

